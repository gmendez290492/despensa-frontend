    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "4.3.3",
