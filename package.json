{
  "name": "despensa-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "generate:api": "openapi-typescript ./docs/openapi.json -o ./src/lib/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.9",
    "@serwist/next": "^9.6.0",
    "@tanstack/react-query": "^5.108.4",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "serwist": "^9.6.0",
    "tailwind-merge": "^3.7.1",
    "xstate": "^5.33.4",
    "zod": "^4.6.7",
