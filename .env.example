# URL interna servidor-a-servidor hacia FastAPI (usada por Next.js BFF / Server Components)
BACKEND_API_URL=http://localhost:8000

# (Opcional, solo servidor) Fuerza el atributo Secure de las cookies HttpOnly de sesión.
# Por defecto: Secure solo con NODE_ENV=production. Usa "false" para `pnpm start` en http local.
# AUTH_COOKIE_SECURE=false

# (Recomendado en producción, solo servidor) Origen público canónico de la app.
# El BFF compara el header Origin de las mutaciones contra este valor (defensa CSRF).
# Si no se define, se usa el origen de la petición (request.nextUrl), nunca X-Forwarded-Host.
APP_ORIGIN=http://localhost:3000

# Variables públicas expuestas al navegador
NEXT_PUBLIC_APP_NAME="Despensa"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# (Opcional, solo servidor) Proxies de confianza delante de Next (CDN, balanceador...).
# El BFF toma la IP del cliente de X-Forwarded-For contando estos saltos desde la derecha
# y la reenvía a FastAPI para el rate limit por IP. Por defecto: 1.
# En FastAPI, FORWARDED_ALLOW_IPS debe incluir la IP del servidor Next.
# TRUSTED_PROXY_HOPS=1
